{
  "excel": {
    "sheet": "RS_Check",
    "header_row": 1,
    "data_start_row": 2,
    "validate_headers": false
  },
  "columns": {
    "Intf_type": 1,
    "RS_module": 2,
    "RS_inst": 3,
    "position": 4,
    "step": 5,
    "clk": 6,
    "rst": 7,
    "CRG_source": 8,
    "RS_CFG_EN": 9
  },
  "position_mappings": {
    "tile_core": "top.u_tile"
  },
  "crg_source_mappings": {
    "crg_aux": "top.u_tile.u_aux_crg",
    "crg_core": "top.u_tile.u_crg"
  },
  "rtl": {
    "clk_port": "clk",
    "rst_port": "rst",
    "suffix_regex": "(?P<tag>.+?)(?P<index>[0-9]+)",
    "index_base": 0,
    "require_contiguous_indices": false,
    "allow_leaf_signal_match": false,
    "crg_match": "module",
    "crg_trace_max_depth": 16
  },
  "module_rules": {
    "rs_pipe": {
      "has_rs_cfg_en": true,
      "step_parameters": [
        "rs_mode"
      ],
      "clk_port": "clk",
      "rst_port": "rst"
    },
    "rs_plain": {
      "has_rs_cfg_en": false,
      "step_parameters": [],
      "clk_port": "clk",
      "rst_port": "rst"
    }
  }
}
